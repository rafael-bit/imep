generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_DB_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  isLeader      Boolean   @default(false)
  password      String?
  role          Role      @default(USER)
  church        Church?   @relation(fields: [churchId], references: [id])
  churchId      String?

  accounts Account[]
  sessions Session[]
  todos    Todo[]
  agendas  Agenda[]

  @@map("users")
}

enum Role {
  USER
  MEDIA_CHURCH
  WORSHIP_CHURCH
  WORKERS
  MASTER
  DEVELOPER
}

enum EquipmentType {
  AUDIO
  VIDEO
  INSTRUMENT
  LIGHTING
  COMPUTER
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model Church {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  songs            Song[]
  equipments       Equipment[]
  galleries        Gallery[]
  playlists        Playlist[]
  teamMembers      TeamMember[]
  workerSchedules  WorkerSchedule[]
  worshipSchedules WorshipSchedule[]
  mediaSchedules   MediaSchedule[]

  @@map("churches")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Todo {
  id    String @id @default(cuid())
  title String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("todo")
}

model Agenda {
  id          String    @id @default(cuid())
  title       String
  description String
  image       String?
  date        DateTime?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agenda")
}

model Volunteer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  baptized  Boolean
  ministry  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("volunteers")
}

model Song {
  id          String    @id @default(cuid())
  title       String
  artist      String
  key         String
  bpm         Int       @default(0)
  category    String
  lyrics      String?   @db.Text
  chords      String?   @db.Text
  youtubeLink String?
  lastPlayed  DateTime?
  church      Church    @relation(fields: [churchId], references: [id])
  churchId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playlistSongs PlaylistSong[]

  @@unique([title, artist, churchId])
  @@map("songs")
}

model Equipment {
  id           String          @id @default(cuid())
  name         String
  type         EquipmentType
  status       EquipmentStatus @default(AVAILABLE)
  assignedTo   String?
  notes        String?
  serialNumber String?
  purchaseDate DateTime?
  church       Church          @relation(fields: [churchId], references: [id])
  churchId     String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("equipments")
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  church      Church   @relation(fields: [churchId], references: [id])
  churchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images GalleryImage[]

  @@map("galleries")
}

model GalleryImage {
  id        String  @id @default(cuid())
  url       String
  caption   String?
  order     Int     @default(0)
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  galleryId String

  @@map("gallery_images")
}

model Playlist {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  eventType String
  church    Church   @relation(fields: [churchId], references: [id])
  churchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs PlaylistSong[]

  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(cuid())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId     String
  order      Int
  key        String? // Override song key
  notes      String?

  @@unique([playlistId, songId])
  @@map("playlist_songs")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  church    Church   @relation(fields: [churchId], references: [id])
  churchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

model WorkerSchedule {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  church      Church   @relation(fields: [churchId], references: [id])
  churchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("worker_schedules")
}

model WorshipSchedule {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  church      Church   @relation(fields: [churchId], references: [id])
  churchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("worship_schedules")
}

model MediaSchedule {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  church      Church   @relation(fields: [churchId], references: [id])
  churchId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media_schedules")
}
